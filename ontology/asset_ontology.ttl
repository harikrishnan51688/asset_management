@prefix asset: <http://wazuh.asset.management/ontology#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://wazuh.asset.management/ontology> a owl:Ontology ;
    dcterms:title "Wazuh IT Asset Management & Security Vulnerability Ontology" ;
    dcterms:description "Formal ontology for modeling Wazuh endpoint agents, hardware specifications, network interfaces, operating systems, running services, and security vulnerabilities." ;
    owl:versionInfo "1.0.0" .

#################################################################
#    Classes
#################################################################

asset:Asset a owl:Class ;
    rdfs:label "Asset" ;
    rdfs:comment "Base class representing any managed IT resource." .

asset:Agent a owl:Class ;
    rdfs:subClassOf asset:Asset ;
    rdfs:label "Wazuh Agent" ;
    rdfs:comment "A Wazuh monitored endpoint or manager node." .

asset:ManagerAgent a owl:Class ;
    rdfs:subClassOf asset:Agent ;
    rdfs:label "Wazuh Manager" ;
    rdfs:comment "The central Wazuh manager server node." .

asset:EndpointAgent a owl:Class ;
    rdfs:subClassOf asset:Agent ;
    rdfs:label "Wazuh Endpoint Agent" ;
    rdfs:comment "A monitored client host reporting to the Wazuh Manager." .

asset:OperatingSystem a owl:Class ;
    rdfs:label "Operating System" ;
    rdfs:comment "Operating system specifications installed on an agent." .

asset:IPAddress a owl:Class ;
    rdfs:label "IP Address" ;
    rdfs:comment "Network IP address assigned to an agent interface." .

asset:NetworkInterface a owl:Class ;
    rdfs:label "Network Interface" ;
    rdfs:comment "Physical or virtual network adapter." .

asset:HardwareSpec a owl:Class ;
    rdfs:label "Hardware Specification" ;
    rdfs:comment "CPU, memory, motherboard, and system hardware specs." .

asset:Vulnerability a owl:Class ;
    rdfs:label "Security Vulnerability" ;
    rdfs:comment "A CVE security flaw detected on an endpoint asset." .

asset:SoftwarePackage a owl:Class ;
    rdfs:label "Software Package" ;
    rdfs:comment "An installed application or system library." .

asset:NetworkPort a owl:Class ;
    rdfs:label "Network Port" ;
    rdfs:comment "An open or listening TCP/UDP port." .

asset:AgentGroup a owl:Class ;
    rdfs:label "Agent Group" ;
    rdfs:comment "Logical grouping of agents in Wazuh." .

#################################################################
#    Object Properties (Relationships)
#################################################################

asset:hasOS a owl:ObjectProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range asset:OperatingSystem ;
    rdfs:label "has operating system" .

asset:hasIP a owl:ObjectProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range asset:IPAddress ;
    rdfs:label "has IP address" .

asset:hasNetworkInterface a owl:ObjectProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range asset:NetworkInterface ;
    rdfs:label "has network interface" .

asset:hasHardware a owl:ObjectProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range asset:HardwareSpec ;
    rdfs:label "has hardware spec" .

asset:hasVulnerability a owl:ObjectProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range asset:Vulnerability ;
    rdfs:label "has vulnerability" .

asset:installedPackage a owl:ObjectProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range asset:SoftwarePackage ;
    rdfs:label "installed software package" .

asset:hasPort a owl:ObjectProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range asset:NetworkPort ;
    rdfs:label "has listening port" .

asset:belongsToGroup a owl:ObjectProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range asset:AgentGroup ;
    rdfs:label "belongs to group" .

asset:managedBy a owl:ObjectProperty ;
    rdfs:domain asset:EndpointAgent ;
    rdfs:range asset:ManagerAgent ;
    rdfs:label "managed by manager" .

asset:affectsPackage a owl:ObjectProperty ;
    rdfs:domain asset:Vulnerability ;
    rdfs:range asset:SoftwarePackage ;
    rdfs:label "affects software package" .

#################################################################
#    Data Properties (Attributes)
#################################################################

asset:agentId a owl:DatatypeProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range xsd:string .

asset:agentName a owl:DatatypeProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range xsd:string .

asset:status a owl:DatatypeProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range xsd:string .

asset:wazuhVersion a owl:DatatypeProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range xsd:string .

asset:lastKeepAlive a owl:DatatypeProperty ;
    rdfs:domain asset:Agent ;
    rdfs:range xsd:dateTime .

asset:ipAddress a owl:DatatypeProperty ;
    rdfs:domain asset:IPAddress ;
    rdfs:range xsd:string .

asset:macAddress a owl:DatatypeProperty ;
    rdfs:domain asset:NetworkInterface ;
    rdfs:range xsd:string .

asset:osName a owl:DatatypeProperty ;
    rdfs:domain asset:OperatingSystem ;
    rdfs:range xsd:string .

asset:osVersion a owl:DatatypeProperty ;
    rdfs:domain asset:OperatingSystem ;
    rdfs:range xsd:string .

asset:osArchitecture a owl:DatatypeProperty ;
    rdfs:domain asset:OperatingSystem ;
    rdfs:range xsd:string .

asset:cveId a owl:DatatypeProperty ;
    rdfs:domain asset:Vulnerability ;
    rdfs:range xsd:string .

asset:severity a owl:DatatypeProperty ;
    rdfs:domain asset:Vulnerability ;
    rdfs:range xsd:string .

asset:cvssScore a owl:DatatypeProperty ;
    rdfs:domain asset:Vulnerability ;
    rdfs:range xsd:float .

asset:vulnerabilityTitle a owl:DatatypeProperty ;
    rdfs:domain asset:Vulnerability ;
    rdfs:range xsd:string .

asset:cpuName a owl:DatatypeProperty ;
    rdfs:domain asset:HardwareSpec ;
    rdfs:range xsd:string .

asset:ramTotal a owl:DatatypeProperty ;
    rdfs:domain asset:HardwareSpec ;
    rdfs:range xsd:string .
