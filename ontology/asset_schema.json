{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WazuhAssetOntologySchema",
  "description": "JSON-LD Context and Schema definition for Wazuh Agent Asset Management Knowledge Graph.",
  "@context": {
    "asset": "http://wazuh.asset.management/ontology#",
    "id": "@id",
    "type": "@type",
    "Agent": "asset:Agent",
    "ManagerAgent": "asset:ManagerAgent",
    "EndpointAgent": "asset:EndpointAgent",
    "OperatingSystem": "asset:OperatingSystem",
    "IPAddress": "asset:IPAddress",
    "HardwareSpec": "asset:HardwareSpec",
    "Vulnerability": "asset:Vulnerability",
    "SoftwarePackage": "asset:SoftwarePackage",
    "NetworkPort": "asset:NetworkPort",
    "AgentGroup": "asset:AgentGroup",
    "hasOS": { "@id": "asset:hasOS", "@type": "@id" },
    "hasIP": { "@id": "asset:hasIP", "@type": "@id" },
    "hasHardware": { "@id": "asset:hasHardware", "@type": "@id" },
    "hasVulnerability": { "@id": "asset:hasVulnerability", "@type": "@id" },
    "installedPackage": { "@id": "asset:installedPackage", "@type": "@id" },
    "hasPort": { "@id": "asset:hasPort", "@type": "@id" },
    "belongsToGroup": { "@id": "asset:belongsToGroup", "@type": "@id" },
    "managedBy": { "@id": "asset:managedBy", "@type": "@id" },
    "cveId": "asset:cveId",
    "severity": "asset:severity",
    "cvssScore": "asset:cvssScore",
    "osName": "asset:osName",
    "osVersion": "asset:osVersion",
    "ipAddress": "asset:ipAddress"
  },
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string" },
          "properties": { "type": "object" }
        },
        "required": ["id", "label", "type"]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relationship": { "type": "string" },
          "label": { "type": "string" }
        },
        "required": ["source", "target", "relationship"]
      }
    }
  }
}
